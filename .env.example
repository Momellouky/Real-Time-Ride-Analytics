COMPOSE_PROJECT_NAME=ride-analytics
PINOT_IMAGE=apachepinot/pinot:1.5.1
KAFKA_IMAGE=apache/kafka:3.9.1
ZOOKEEPER_IMAGE=zookeeper:3.9.3
KAFKA_PORT=9092
PINOT_CONTROLLER_PORT=9000
PINOT_BROKER_PORT=8099
KAFKA_TOPIC=ride-metrics-snapshots
ZONE_ID=ZONE_1
PINOT_CONTROLLER_URL=http://localhost:9000
PINOT_BROKER_URL=http://localhost:8099
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DASHBOARD_POLL_INTERVAL_MS=2000
